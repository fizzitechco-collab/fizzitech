"""Windows-safe, bounded clip fetching for long remote videos.

Each yt-dlp/FFmpeg download runs in its own process *tree*, so a stalled network
seek cannot outlive a clip cancellation or block a worker indefinitely.
Never logs signed YouTube media URLs. No user data or AI keys are stored here.
"""
from __future__ import annotations

import os
import re
import json
import shutil
import signal
import subprocess
import sys
import threading
import time
from pathlib import Path

from . import config

_NO_WINDOW = getattr(subprocess, "CREATE_NO_WINDOW", 0)
_NEW_GROUP = getattr(subprocess, "CREATE_NEW_PROCESS_GROUP", 0)
_URL = re.compile(r"https?://[^\s\"']+", re.I)
_ANSI = re.compile(r"\x1b\[[0-9;]*m")


class DownloadCancelled(Exception):
    """User stopped this clip or its parent job."""


class DownloadFailure(RuntimeError):
    """A source clip could not be downloaded within configured limits."""


def _setting_int(name: str, default: int, lo: int, hi: int) -> int:
    try:
        return max(lo, min(hi, int(config.env(name, str(default)))))
    except (ValueError, TypeError):
        return default


MAX_FETCH_SECONDS = _setting_int("PEAKCUT_SEGMENT_TIMEOUT", 210, 20, 600)
IDLE_SECONDS = _setting_int("PEAKCUT_DOWNLOAD_IDLE_TIMEOUT", 75, 10, 180)
FALLBACK_SECONDS = _setting_int("PEAKCUT_FALLBACK_TIMEOUT", 900, 60, 3600)
FALLBACK_HEIGHT = _setting_int("PEAKCUT_FALLBACK_HEIGHT", 360, 144, 720)
# LEGEND_SOURCE1080_SEGMENTS_V1: even if environment requests 2160, never download above 1080.
FETCH_HEIGHT_CAP = min(1080, _setting_int("PEAKCUT_FETCH_HEIGHT_CAP", 1080, 144, 2160))
FALLBACK_MAX_GB = _setting_int("PEAKCUT_FALLBACK_MAX_GB", 2, 1, 20)
DOWNLOAD_SLOTS = _setting_int("PEAKCUT_SEGMENT_DOWNLOADS", 1, 1, 4)

_slots = threading.BoundedSemaphore(DOWNLOAD_SLOTS)
_fallback_locks: dict[str, threading.Lock] = {}
_fallback_lock = threading.Lock()


def _redact(message: str) -> str:
    return _ANSI.sub("", _URL.sub("[remote URL hidden]", message))[-1100:]


def _check(cancelled):
    if cancelled and cancelled():
        raise DownloadCancelled("Clip download cancelled")


def _terminate_tree(proc: subprocess.Popen):
    if proc.poll() is not None:
        return
    if os.name == "nt":
        # Killing only the yt-dlp Python PID leaks its nested ffmpeg.exe child on Windows.
        try:
            subprocess.run(["taskkill", "/PID", str(proc.pid), "/T", "/F"],
                           stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           creationflags=_NO_WINDOW, timeout=8, check=False)
        except (OSError, subprocess.TimeoutExpired):
            pass
    else:
        try:
            os.killpg(proc.pid, signal.SIGKILL)
        except ProcessLookupError:
            pass
    if proc.poll() is None:
        proc.kill()
    try:
        proc.wait(timeout=4)
    except subprocess.TimeoutExpired:
        pass


def _sizes(paths: list[Path]) -> tuple[int, bool]:
    size, found = 0, False
    for glob in paths:
        for p in glob.parent.glob(glob.name):
            if not p.is_file():
                continue
            try:
                size += p.stat().st_size
                found = True
            except FileNotFoundError:
                continue
    return size, found


def _run_bounded(cmd: list[str], directory: Path, output_pattern: str, max_seconds: int,
                 cancelled=None, idle_seconds: int = IDLE_SECONDS, max_bytes: int | None = None,
                 progress=None):
    """Supervisor with absolute AND no-output timeout; always waits/kills child tree."""
    _check(cancelled)
    directory.mkdir(parents=True, exist_ok=True)
    log = directory / "._peakcut_download_stderr"
    t0 = time.monotonic()
    proc = None
    try:
        with open(log, "wb") as stderr:
            proc = subprocess.Popen(cmd, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                                    stderr=stderr, cwd=str(directory),
                                    creationflags=(_NO_WINDOW | _NEW_GROUP) if os.name == "nt" else 0,
                                    start_new_session=os.name != "nt")
            last_bytes = -1
            last_change = t0
            last_report = t0 - 5
            while proc.poll() is None:
                _check(cancelled)
                now = time.monotonic()
                if now - t0 > max_seconds:
                    raise DownloadFailure(f"Clip fetch exceeded {max_seconds}s. Try a local video upload.")
                bytes_now, _ = _sizes([directory / output_pattern])
                if max_bytes and bytes_now > max_bytes:
                    raise DownloadFailure("Full livestream fallback exceeded the configured size limit "
                                      "(PEAKCUT_FALLBACK_MAX_GB). No more whole-video data will be fetched. "
                                      "Use Segments-Only mode or upload a local MP4.")
                if bytes_now != last_bytes:
                    last_bytes, last_change = bytes_now, now
                    if progress and now - last_report >= 5 and bytes_now > 0:
                        last_report = now
                        progress(bytes_now, now - t0)
                elif now - last_change > idle_seconds:
                    raise DownloadFailure(f"Download made no file progress for {idle_seconds}s; stopped automatically.")
                time.sleep(0.25)
            _check(cancelled)
            if proc.returncode:
                details = _redact(log.read_text(encoding="utf-8", errors="replace"))
                raise DownloadFailure(f"Video source download failed (exit {proc.returncode}). {details[-350:]}")
    except BaseException:
        if proc is not None:
            _terminate_tree(proc)
        raise
    finally:
        try:
            log.unlink(missing_ok=True)
        except OSError:
            pass


def _result(directory: Path, stem: str) -> Path:
    paths = [p for p in directory.glob(stem + ".*")
             if p.is_file() and p.suffix.lower() in (".mp4", ".mkv", ".webm", ".mov") and p.stat().st_size > 4096]
    if not paths:
        raise DownloadFailure("Downloaded segment was empty. Try a local MP4 upload.")
    return max(paths, key=lambda p: p.stat().st_size)


def _remove_incomplete(directory: Path, stem: str):
    # Remove only this clip's partial work. Never touch completed rendered clips, job JSON or input video.
    for p in directory.glob(stem + ".*"):
        if p.is_file() and (p.name.endswith((".part", ".ytdl")) or p.suffix.lower() in (".mp4", ".mkv", ".webm")):
            try:
                p.unlink()
            except OSError:
                pass


def _acquire(cancelled):
    while not _slots.acquire(timeout=0.3):
        _check(cancelled)
    try:
        _check(cancelled)
    except BaseException:
        _slots.release()
        raise


def _is_youtube_url(url: str) -> bool:
    from urllib.parse import urlsplit
    try:
        host = (urlsplit(url).hostname or "").lower()
        return host in ("youtube.com", "youtu.be", "www.youtube.com", "m.youtube.com", "music.youtube.com")
    except ValueError:
        return False


def _yt_dlp_base(url: str) -> list[str]:
    # EJS is needed by current YouTube extractors. Deno (2.3+) or another
    # supported JS runtime must be present on the user's computer.
    args = [sys.executable, "-m", "yt_dlp", "--no-playlist", "--no-warnings", "--no-progress",
            "--socket-timeout", "12", "--retries", "1", "--fragment-retries", "1",
            "--extractor-retries", "1", "--no-write-info-json"]
    if _is_youtube_url(url):
        # Match the yt-dlp + Deno combination verified on the user's Windows PC.
        # A working Deno runtime is required for many current YouTube player challenges.
        if shutil.which("deno"):
            args += ["--js-runtimes", "deno"]
        if config.env("PEAKCUT_EJS_NPM", "1") == "1":
            args += ["--remote-components", "ejs:npm"]
    return args


def _source_cap(export_height: int) -> int:
    """Prefer higher-than-export source resolution to reduce 16:9 -> 9:16 crop blur.

    At 1080x1920, a 1920x1080 source yields only ~608 pixels of real
    horizontal detail once center-cropped. 4K makes the crop ~1215 pixels.
    """
    height = int(export_height)
    desired = 2160 if height >= 1080 else (1440 if height >= 720 else height)
    return min(desired, FETCH_HEIGHT_CAP, 1080)


def _hd_min_height(export_height: int) -> int:
    """No misleading upscale from 360p when HD is requested."""
    height = int(export_height)
    return 1080 if height >= 1080 else (720 if height >= 720 else 0)


def _section_cmd(url: str, template: str, start: float, end: float, height: int,
                 *, alternate: bool = False) -> list[str]:
    """Download only the requested time range. HD excludes ALL sub-HD sources.

    Attempt 1 prefers MP4/H.264 adaptive streams if available, then other HD
    adaptive formats. Attempt 2 tries alternative high-quality streams.
    Neither attempt ever asks yt-dlp to silently choose 360p for HD mode.
    """
    cap = _source_cap(height)
    minimum = _hd_min_height(height)
    section = f"*{start:.3f}-{end:.3f}"
    if minimum and cap < minimum:
        raise DownloadFailure(
            f"Configuration limits source to {cap}p but {minimum}p is selected. "
            f"Use a source matching the requested {minimum}p quality. "
            "in the launcher or start PeakCut using START-PEAKCUT-SMART.bat."
        )
    if _is_youtube_url(url) and minimum:
        restricted = f"[height>={minimum}][height<={cap}]"
        if not alternate:
            # Most compatible first: AVC + M4A, then VP9/AV1+audio.
            fmt = (f"bv[ext=mp4][vcodec^=avc1]{restricted}+ba[ext=m4a]/"
                   f"bv{restricted}+ba/"
                   f"b{restricted}")
        else:
            # Some streams expose only WebM or AV1 at high resolutions.
            fmt = (f"bv[ext=webm]{restricted}+ba/"
                   f"bv[vcodec^=av01]{restricted}+ba/"
                   f"bv{restricted}+ba/"
                   f"b{restricted}")
    elif _is_youtube_url(url) and cap >= 360:
        fmt = ("18/b[ext=mp4][height<=360]/b[height<=360]" if not alternate else
               "b[ext=mp4][height<=360]/18/b[height<=360]")
    elif alternate:
        fmt = f"bv*[height<={cap}][vcodec^=avc1]+ba[ext=m4a]/bv*[height<={cap}]+ba"
    else:
        fmt = f"b[ext=mp4][height<={cap}]/b[height<={cap}]/bv*[height<={cap}]+ba"
    return _yt_dlp_base(url) + ["--download-sections", section,
        "--force-overwrites", "--merge-output-format", "mkv" if minimum else "mp4", "-f", fmt,
        "-o", template, url]


def _probe_downloaded_height(path: Path) -> tuple[int, int]:
    """Actual decoded frame dimensions, not yt-dlp's advertised resolution."""
    try:
        proc = subprocess.run([
            "ffprobe", "-v", "error", "-select_streams", "v:0",
            "-show_entries", "stream=width,height", "-of", "json", str(path)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=25,
            creationflags=_NO_WINDOW)
        if proc.returncode:
            raise DownloadFailure("Could not inspect downloaded video stream.")
        streams = json.loads(proc.stdout).get("streams", [])
        if not streams:
            raise DownloadFailure("Downloaded media contains no video.")
        w, h = int(streams[0].get("width", 0)), int(streams[0].get("height", 0))
        if w < 16 or h < 16:
            raise DownloadFailure("Downloaded video resolution was invalid.")
        return w, h
    except (OSError, subprocess.TimeoutExpired, ValueError, TypeError, KeyError) as e:
        raise DownloadFailure(f"Unable to verify source resolution: {str(e)[-130:]}") from None


def _verify_source(path: Path, export_height: int, stage=None):
    w, h = _probe_downloaded_height(path)
    actual = min(w, h)
    required = _hd_min_height(export_height)
    if required and actual < required:
        raise DownloadFailure(
            f"Source came back only {w}x{h} ({actual}p) while {export_height}p was selected. "
            "PeakCut REFUSED to upscale a low-resolution stream and call it HD. "
            "Try a higher-quality source, update yt-dlp/Deno, or explicitly select 360p."
        )
    if stage:
        stage(f"Verified source: {w}x{h} ({actual}p), export: {export_height}p")


def _full_cmd(url: str, template: str, height: int) -> list[str]:
    cap = min(int(height), FETCH_HEIGHT_CAP)
    return _yt_dlp_base(url) + ["--merge-output-format", "mp4",
        "-f", f"b[height<={cap}][ext=mp4]/b[height<={cap}]/bv*[height<={cap}]+ba",
        "-o", template, url]


def _media_tracks(source: Path) -> set[str]:
    """Check cached fallback is a real playable source, not an unfinished download."""
    try:
        proc = subprocess.run(
            ["ffprobe", "-v", "error", "-show_entries", "stream=codec_type",
             "-of", "json", str(source)],
            stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True,
            timeout=18, creationflags=_NO_WINDOW)
    except (OSError, subprocess.TimeoutExpired):
        return set()
    if proc.returncode:
        return set()
    try:
        return {stream.get("codec_type", "") for stream in json.loads(proc.stdout).get("streams", [])}
    except (ValueError, TypeError, AttributeError):
        return set()


def _local_segment(src: Path, directory: Path, stem: str, start: float, end: float, cancelled):
    # Choose the first video/audio streams automatically. An explicit -map
    # 0:v:0 has failed with "Invalid argument" on users' Windows FFmpeg builds.
    # The local media is already downloaded, so seeking is quick.
    _check(cancelled)
    tracks = _media_tracks(src)
    if "video" not in tracks:
        raise DownloadFailure("Downloaded fallback file has no readable video track. Try a local MP4 upload.")
    if "audio" not in tracks:
        raise DownloadFailure("Downloaded fallback file has no audio track. Try a local MP4 with audio.")
    target = directory / f"{stem}.mp4"
    cmd = ["ffmpeg", "-nostdin", "-y", "-hide_banner", "-loglevel", "error",
           "-ss", f"{start:.3f}", "-i", str(src), "-t", f"{end-start:.3f}",
           "-sn", "-dn", "-c", "copy", "-avoid_negative_ts", "make_zero",
           "-f", "mp4", str(target)]
    _run_bounded(cmd, directory, f"{stem}.mp4", min(180, max(45, int(end-start)*3)),
                 cancelled=cancelled, idle_seconds=60)
    if not target.exists() or target.stat().st_size <= 4096:
        raise DownloadFailure("FFmpeg produced an empty clip file. Check source timestamps.")
    return _result(directory, stem)


def _lock_for(folder: Path):
    key = str(folder.resolve())
    with _fallback_lock:
        return _fallback_locks.setdefault(key, threading.Lock())


def _cached_source(url: str, cache_dir: Path, cancelled, stage):
    cached = list(cache_dir.glob("peakcut_fallback_source.*"))
    for p in cached:
        if p.suffix.lower() in (".mp4", ".mkv", ".webm") and p.stat().st_size > 4096:
            if {"video", "audio"}.issubset(_media_tracks(p)):
                return p
    _check(cancelled)
    cache_dir.mkdir(parents=True, exist_ok=True)
    if stage:
        stage(f"Downloading a smaller source copy ({FALLBACK_HEIGHT}p)")
    stem = "peakcut_fallback_source"
    _remove_incomplete(cache_dir, stem)
    cmd = _full_cmd(url, str(cache_dir / (stem + ".%(ext)s")), FALLBACK_HEIGHT)
    try:
        _run_bounded(cmd, cache_dir, stem + ".*", FALLBACK_SECONDS, cancelled=cancelled,
                     idle_seconds=max(90, IDLE_SECONDS), max_bytes=FALLBACK_MAX_GB * 1024**3,
                     progress=(lambda size, elapsed: stage(
                         f"Fetching source ({FALLBACK_HEIGHT}p): {size / 1048576:.0f} MB, "
                         f"{size / 1048576 / max(1, elapsed):.1f} MB/s")) if stage else None)
    except BaseException:
        # A rejected multi-GB fallback must not leave a massive .part file
        # consuming the laptop's disk. Only remove this download's temp files.
        for path in cache_dir.glob(stem + ".*"):
            if path.name.endswith((".part", ".ytdl")):
                try:
                    path.unlink()
                except OSError:
                    pass
        raise
    return _result(cache_dir, stem)


def download_section(url: str, out_dir: Path, stem: str, start: float, end: float, height=720,
                     *, cache_dir: Path | None = None, cancelled=None, stage=None) -> Path:
    """Selected video section only, with STRICT source-resolution checks for HD.

    360p keeps the working, verified progressive format 18 and optional legacy
    fallback. 720p/1080p never silently downgrade to 360p; both attempts must
    download actual >=720p/1080p respectively or produce a clear error.
    """
    if not 0 <= start < end:
        raise ValueError("Invalid video clip times")
    out_dir = Path(out_dir)
    out_dir.mkdir(parents=True, exist_ok=True)
    height = min(1080, int(height))
    cap = _source_cap(height)
    minimum = _hd_min_height(height)
    if minimum and cap < minimum:
        raise DownloadFailure(f"Source height cap is {cap}p; raise PEAKCUT_FETCH_HEIGHT_CAP to at least {minimum}p.")
    _acquire(cancelled)
    errors = []
    try:
        for attempt in (1, 2):
            _check(cancelled)
            if stage:
                if minimum:
                    stage((f"HD attempt {attempt}/2: requesting {minimum}-{cap}p source "
                           "(never silently using 360p)"))
                else:
                    stage("Downloading the selected 360p segment" if attempt == 1 else
                          "Retrying the selected 360p segment")
            _remove_incomplete(out_dir, stem)
            try:
                cmd = _section_cmd(url, str(out_dir / (stem + ".%(ext)s")), start, end, height,
                                   alternate=(attempt == 2))
                _run_bounded(cmd, out_dir, stem + ".*", MAX_FETCH_SECONDS, cancelled=cancelled,
                             progress=(lambda size, elapsed: stage(
                                 f"Downloading segment: {size / 1048576:.1f} MB, "
                                 f"{size / 1048576 / max(1, elapsed):.1f} MB/s")) if stage else None)
                result = _result(out_dir, stem)
                _verify_source(result, height, stage)
                return result
            except DownloadCancelled:
                raise
            except (DownloadFailure, OSError) as e:
                errors.append(str(e))
                # Try an alternative HD stream next. Do NOT fall back to format 18.
        if minimum:
            raise DownloadFailure(
                f"Unable to fetch genuine {height}p-or-better video for this selected segment. "
                "YouTube may be rejecting separate HD video/audio streams (HTTP 403), "
                "or that resolution may not be available for this recording. "
                "The 360p fallback was intentionally disabled so clips cannot silently look blurry. "
                + "; ".join(_redact(e)[-240:] for e in errors[-2:])
            )
        if config.env("PEAKCUT_FULL_SOURCE_FALLBACK", "0").strip() != "1" or cache_dir is None:
            raise DownloadFailure("; ".join(errors[-2:]))
        cache_dir = Path(cache_dir)
        lock = _lock_for(cache_dir)
        while not lock.acquire(timeout=0.3):
            _check(cancelled)
        try:
            src = _cached_source(url, cache_dir, cancelled, stage)
        finally:
            lock.release()
        _check(cancelled)
        if stage:
            stage("Cutting the local 360p source")
        _remove_incomplete(out_dir, stem)
        result = _local_segment(src, out_dir, stem, start, end, cancelled)
        _verify_source(result, height, stage)
        return result
    except DownloadCancelled:
        _remove_incomplete(out_dir, stem)
        raise
    except (OSError, DownloadFailure) as e:
        _remove_incomplete(out_dir, stem)
        if minimum:
            raise DownloadFailure("HD selected clip unavailable: " + _redact(str(e))) from None
        raise DownloadFailure("Could not retrieve the selected 360p clip. "
                              "YouTube may require a current yt-dlp, Deno/EJS or access token. "
                              "Try a 15-second manual segment download or upload your own MP4. "
                              + _redact(str(e))) from None
    finally:
        _slots.release()
